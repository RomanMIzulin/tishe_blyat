{
  "name": "tishe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && vite --host 0.0.0.0",
    "build": "node scripts/build.mjs --optimize && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "elm-test",
    "format": "elm-format src tests review/src review/tests --yes",
    "format:check": "elm-format src tests review/src review/tests --validate && prettier --check src/*.js src/*.css scripts/*.mjs e2e/*.js *.js *.json index.html README.md review/elm.json review/README.md",
    "test:e2e": "playwright test",
    "test:review": "cd review && elm-test --compiler ../node_modules/.bin/elm",
    "review": "elm-review --compiler node_modules/.bin/elm --unsuppress",
    "check": "npm run format:check && npm test && npm run test:review && npm run review && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "elm": "0.19.3-0",
    "elm-format": "0.8.8",
    "elm-review": "2.13.5",
    "elm-test": "0.19.3-0",
    "prettier": "^3.9.10",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource/lora": "^5.3.0"
  }
}
